# Local Docker Compose: serve React and proxy requests to the API service.
{$SITE_ADDRESS} {
    encode zstd gzip

    @api path /api /api/* /health/*
    handle @api {
        reverse_proxy api:5001
    }

    handle {
        root * /srv
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
            X-Frame-Options DENY
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
        @assets path /assets/*
        handle @assets {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            header Cache-Control "no-cache"
            try_files {path} /index.html
            file_server
        }
    }
}
