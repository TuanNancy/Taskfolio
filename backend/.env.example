# Backend environment variables
MONGO_URI=mongodb://127.0.0.1:27017/todo-app
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Configuration
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Cookie lifetime is derived from JWT_EXPIRES_IN.
COOKIE_SAME_SITE=lax
# Set to 1 ONLY behind a single trusted reverse proxy; do not expose the API port.
TRUST_PROXY_HOPS=0
